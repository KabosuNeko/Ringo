
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true

    match app-id=r#".*"#
    background-effect {
        xray true
        blur true
        noise 0.02
        saturation 1
    }
}

// the focus cue: focus-ring and border are off, so only inactive windows fade
window-rule {
    match is-active=false
    opacity 0.9
}


window-rule {
    match app-id=r#"thunar"#
    default-column-width { proportion 0.65; }
}

window-rule {
    match app-id=r#"firefox"#
    open-maximized true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"xdg-desktop-portal-gtk"#
    open-floating true
    default-floating-position x=0 y=0
    min-width 400
    min-height 600
}

window-rule {
    match app-id=r#"foot-scratchpad"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 580; }
}

layer-rule {
    match namespace="^ringo-shell$"
    geometry-corner-radius 20
    background-effect {
        xray false
        blur false
        noise 0
        saturation 1
    }
}

layer-rule {
    match namespace="^ringo-popup$"
    geometry-corner-radius 26
    background-effect {
        xray false
        blur true
        noise 0.05
        saturation 1
    }
}

layer-rule {
    match namespace="^ringo-lock$"
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 1
    }
}

layer-rule {
    match namespace="^ringo-backdrop$"
    place-within-backdrop true
}
