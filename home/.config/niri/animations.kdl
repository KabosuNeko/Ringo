
animations {
    window-open {
        duration-ms 60
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 60
        curve "ease-out-expo"
    }

    horizontal-view-movement {
        duration-ms 60
        curve "ease-out-expo"
    }

    window-movement {
        duration-ms 60
        curve "ease-out-expo"
    }

    window-resize {
        duration-ms 60
        curve "ease-out-expo"
    }

    config-notification-open-close {
        duration-ms 60
        curve "ease-out-expo"
    }

    exit-confirmation-open-close {
        duration-ms 60
        curve "ease-out-expo"
    }

    screenshot-ui-open {
        duration-ms 60
        curve "ease-out-expo"
    }

    overview-open-close {
        duration-ms 60
        curve "ease-out-expo"
    }

    recent-windows-close {
        duration-ms 60
        curve "ease-out-expo"
    }

    workspace-switch {
        duration-ms 60
        curve "ease-out-expo"
    }
}
