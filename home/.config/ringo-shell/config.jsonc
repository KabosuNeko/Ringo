{
  "displayPicture": "~/.pfp.png",
  "clockFormat": "hh:mm",
  "pillTopMargin": 9,
  "pillBottomMargin": 26,
  "textFontFamily": "Maple Mono NF",
  "nerdFontFamily": "Maple Mono NF",
  "notificationDisplayTime": 3000,
  "maxNotificationsInStack": 20,
  "osdDuration": 800,
  "weatherLocation": "Ho Chi Minh City",
  "weatherUnits": "metric",
  "weatherRefreshInterval": 3600000,
  "avoidDuplicateNotifications": true,
  "defaultTerminal": "foot",
  "pillScale": 1.0,
  "dpiScale": 1.0,
  "wallpapersDir": "~/Pictures/Wallpapers",
  "wsCloseOnWallpaperSet": true,
  "wsAnimation": true,
  "nightLightLowTemperature": 4000,
  "nightLightHighTemperature": 6500,
  "nightLightGamma": 1.0,
  "nightLightLatitude": 0,
  "nightLightLongitude": 0,
  "slideshowIntervalMinutes": 30,
  "idleDimSeconds": 300,
  "idleLockSeconds": 330,
  "idleScreenOffSeconds": 360,
  "idleSuspendSeconds": 600
}
