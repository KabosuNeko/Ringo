#!/usr/bin/env bash
# QML in ~/.config/ringo-shell, built backend module in its IslandBackend/.

RINGO_DIR="$HOME/.config/ringo-shell"

if [ "$1" = "call" ]; then
    exec qs ipc -p "$RINGO_DIR" "$@"
fi

export LD_LIBRARY_PATH="$RINGO_DIR/IslandBackend:$LD_LIBRARY_PATH"
export QML_IMPORT_PATH="$RINGO_DIR:$QML_IMPORT_PATH"
exec qs -n -d -p "$RINGO_DIR"
